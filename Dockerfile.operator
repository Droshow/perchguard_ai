FROM golang:1.26-alpine AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /perchguard-operator ./cmd/perchguard-operator/

FROM alpine:latest

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /perchguard-operator /perchguard-operator

ENV PERCHGUARD_POLICY=/etc/perchguard/policies.yaml
ENV PERCHGUARD_METRICS_ADDR=:8081

EXPOSE 8081

ENTRYPOINT ["/perchguard-operator"]
